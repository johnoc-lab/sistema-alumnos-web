# Solo nombres y valores públicos de ejemplo vacíos. Sin credenciales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Interruptor PRIVADO; habilitar solo después de configurar Cloud y el origen local.
SUPABASE_AUTH_ENABLED=false
APP_ORIGIN=
# Privado: secreto aleatorio >= 43 caracteres, solo en .env.local ignorado; nunca NEXT_PUBLIC.
AUTH_FLOW_SECRET=
# No se necesita service_role, secret key ni password de base para Auth de aplicación.

# Controles PRIVADOS e independientes. No requieren SMTP para login/logout.
AUTH_EMAIL_RECOVERY_ENABLED=false
AUTH_TOKEN_HASH_RECOVERY_ENABLED=false
AUTH_INVITATION_ACCEPT_ENABLED=false
