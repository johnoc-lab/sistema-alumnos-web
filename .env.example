# Solo nombres y valores públicos de ejemplo vacíos. Sin credenciales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Interruptor PRIVADO; habilitar solo después de configurar Cloud y el origen local.
SUPABASE_AUTH_ENABLED=false
APP_ORIGIN=
# Privado: secreto aleatorio >= 43 caracteres, solo en .env.local ignorado; nunca NEXT_PUBLIC.
AUTH_FLOW_SECRET=
# Login, recuperación y MFA no usan la clave administrativa.
# Alta de personal opcional, habilitar solo después de la migración y las pruebas QA.
STAFF_REGISTRATION_ENABLED=false
# Exclusiva del servidor. No usar NEXT_PUBLIC ni guardar la clave en Git.
SUPABASE_STAFF_SECRET_KEY=

# Controles PRIVADOS e independientes. No requieren SMTP para login/logout.
AUTH_EMAIL_RECOVERY_ENABLED=false
AUTH_TOKEN_HASH_RECOVERY_ENABLED=false
AUTH_INVITATION_ACCEPT_ENABLED=false

# Vercel Preview: configurar solo en el entorno Preview y rama QA, nunca por defecto en Production.
# APP_ORIGIN debe ser el origen HTTPS exacto elegido, sin barra final; no admite comodines.
# AUTH_FLOW_SECRET se genera y guarda como variable privada de Vercel, nunca en este archivo.
# Mantener los tres flujos de correo en false. Login con contraseña y MFA no necesitan SMTP.
