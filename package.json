{
  "name": "sistema-alumnos-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:routes": "node scripts/check-routes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.6.2"
  },
  "type": "module"
}
